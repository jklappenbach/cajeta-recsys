package dev.cajeta.recsys;

import cajeta.math.Tensor;
import cajeta.math.linalg.LinAlg;

/**
 * Singular value thresholding for matrix completion (spec §5.4–§5.5):
 * the (explicitly) filled matrix's singular values are SOFT-thresholded
 * at `tau` — `σ ← max(σ − τ, 0)` — and the low-rank reconstruction
 * returned. The fill is the caller's, like {@link Interactions#toDense}
 * — there is no silent zero.
 *
 * {@link #searchThreshold} selects `tau` like any other hyperparameter:
 * candidates scored on held-out triples through {@link RatingScore},
 * the same machinery every model reports through (§5.5, §12.2).
 */
public final class Svt {

    /** Complete `m` with fill `fill`, soft-threshold at `tau`. */
    public static #SvtModel complete(Interactions m, float64 tau,
                                     float64 fill) {
        if (tau < 0.0) {
            throw heap RsException("Svt: tau must be >= 0 (got " + tau + ")");
        }
        int64 nU = m.userCount();
        int64 nI = m.itemCount();
        Tensor<float64> dense = m.toDense(fill);
        Tensor<float64>[] usv = LinAlg.svd<float64>(dense);
        Tensor<float64> u = usv[0];
        Tensor<float64> s = usv[1];
        Tensor<float64> vt = usv[2];
        int64 r = s.shapeAt(0);
        float64[] shrunk = heap float64[r];
        int64 k = 0;
        while (k < r) {
            float64 v = s.flatGet(k) - tau;
            if (v < 0.0) { v = 0.0; }
            shrunk[k] = v;
            k = k + 1;
        }
        float64[] rc = heap float64[nU * nI];
        int64 a = 0;
        while (a < nU) {
            int64 c = 0;
            while (c < nI) {
                float64 acc = 0.0;
                k = 0;
                while (k < r) {
                    if (shrunk[k] > 0.0) {
                        acc = acc + u.flatGet(a * r + k) * shrunk[k]
                            * vt.flatGet(k * nI + c);
                    }
                    k = k + 1;
                }
                rc[a * nI + c] = acc;
                c = c + 1;
            }
            a = a + 1;
        }
        int64[] sh = heap int64[2]; sh[0] = nU; sh[1] = nI;
        Tensor<float64> rt = Tensor.of<float64>(rc, sh);
        SvtModel model = heap SvtModel(#rt, #shrunk,
            Baselines.observedMean(m), m.minRating(), m.maxRating());
        return #model;
    }

    /**
     * Pick `tau` from `candidates` by held-out RMSE (§5.5): each
     * threshold is fitted on `m` and scored on the held-out triples
     * through {@link RatingScore} — the shared machinery, not a bespoke
     * one. Returns the index of the best candidate.
     */
    public static int64 searchThreshold(Interactions m, float64[] taus,
                                        float64 fill, int64[] us,
                                        int64[] is, float64[] rs) {
        if ((int64) taus.count() < 1) {
            throw heap RsException("Svt.searchThreshold: no candidates");
        }
        int64 best = 0;
        float64 bestScore = 0.0;
        int64 t = 0;
        while (t < (int64) taus.count()) {
            SvtModel model = Svt.complete(m, taus[t], fill);
            float64 score = RatingScore.rmse(model, us, is, rs);
            if (t == 0 || score < bestScore) {
                bestScore = score;
                best = t;
            }
            t = t + 1;
        }
        return best;
    }
}
