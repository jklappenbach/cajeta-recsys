{
    // cajeta-recsys — user-item recommendation for the cajeta ecosystem:
    // the interaction matrix (missing ≠ zero, BY CONSTRUCTION), rating
    // baselines, neighbourhood and matrix-factorization collaborative
    // filtering, singular value thresholding, co-clustering, ranking
    // metrics, and matrix estimation over time series (mSSA).
    //
    // PARITY ORACLES — four, not one (spec §1.3): Surprise 1.1.5 for the
    // collaborative-filtering algorithms (a DIVERGENCE THERE IS A FINDING
    // TO INVESTIGATE, not automatically a cajeta bug — Surprise is small
    // and lightly maintained); scikit-learn 1.9.0 for TF-IDF/cosine;
    // mSSA treated as a research-grade reference. tools/fixtures/gen_recsys.py
    // asserts the pins.
    //
    // A LIBRARY project: no `entry-method`, so the build emits a reusable
    // `.cja` rather than an executable.
    //
    // VERSIONING — `details.version` is the SINGLE source of truth. It names
    // the built archive (`dev.cajeta.recsys-<version>.cja`), it is what CI
    // publishes to Olla, and CI asserts a `v*` tag agrees with it.

    "details": {
        "name":               "dev.cajeta.recsys",
        "version":            "0.1.0",
        "description":        "cajeta-recsys — recommenders: interaction matrix (missing != zero), baselines, neighbourhood + factorization CF, co-clustering, ranking metrics, mSSA",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        "capabilities": [],

        // dev.cajeta.ml: Metrics + KMeans + the protocol where it fits.
        // dev.cajeta.timeseries: the trajectory (Hankel) transform mSSA
        // consumes (roadmap §5.3). dev.cajeta.docs joins when the
        // content-based unit unblocks (cajeta-docs U6–U7 unstarted).
        "dependencies": {
            "dev.cajeta.ml": "0.10.0",
            "dev.cajeta.timeseries": "0.1.1",
            "dev.cajeta.docs": "0.1.0"
        },

        "dev-dependencies": {
            "dev.cajeta.unit": "0.2.0"
        },

        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        "build": {
            "source-root": "src/main/cajeta",
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            "description": "Build + run the library's test suite",
            "actions": [
                { "action": "exec", "command": "./run-tests.sh" }
            ]
        },

        "tour": {
            "description": "Build + run the self-checking tour",
            "actions": [
                { "action": "exec", "command": "./run-tour.sh" }
            ]
        },

        "release": {
            "description": "Release build of the .cja",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Remove build outputs",
            "actions": [
                { "action": "exec", "command": "rm", "args": ["-rf", "build"] }
            ]
        }
    }
}
