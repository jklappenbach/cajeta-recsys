package dev.cajeta.recsys.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import cajeta.math.linalg.LinAlg;
import dev.cajeta.recsys.Baselines;
import dev.cajeta.recsys.GlobalMean;
import dev.cajeta.recsys.Interactions;
import dev.cajeta.recsys.RatingScore;
import dev.cajeta.recsys.SgdMf;
import dev.cajeta.recsys.Svt;
import dev.cajeta.recsys.SvtModel;
import dev.cajeta.recsys.ZeroFilledSvd;

/**
 * ml-recsys U4 — the two SVDs, named distinctly and demonstrably
 * different (4.1.1–4.1.3), seeded reproducibility (4.1.4), Surprise-SVD
 * RMSE parity (4.1.5 — bit parity is impossible across RNGs, recorded),
 * soft-thresholding (4.1.6), the threshold as an ordinary
 * hyperparameter (4.1.7), inspectable factors (4.1.8), and scale
 * clipping (4.1.9).
 */
public class MfTest {

    public MfTest() { return; }

    // 4.1.1 — the zero-filled truncated SVD matches sklearn's
    // TruncatedSVD (arpack) reconstruction and singular values.
    @Test
    public void zeroFilledSvdMatchesSklearn() {
        Interactions m = BaselinesTest.ratings();
        ZeroFilledSvd z = heap ZeroFilledSvd((int64) 5);
        z.fit(m);
        Tensor<float64> want = Fx.load("rs_tsvd_recon");
        Tensor<float64> got = z.reconstruction();
        // Map: fixture rows/cols are raw ids; ours are first-appearance.
        int64 nU = m.userCount();
        int64 nI = m.itemCount();
        int64 u = 0;
        while (u < nU) {
            int64 mu = m.userIndex("" + u);
            int64 i = 0;
            while (i < nI) {
                int64 mi = m.itemIndex("" + i);
                Assert.isTrue(Fx.close(got.flatGet(mu * nI + mi),
                    want.flatGet(u * nI + i), 0.00000001));
                i = i + 1;
            }
            u = u + 1;
        }
        Tensor<float64> ws = Fx.load("rs_tsvd_singular");
        float64[] sg = z.singularValues();
        int64 k = 0;
        while (k < 5) {
            Assert.isTrue(Fx.close(sg[k], ws.flatGet(k), 0.00000001));
            k = k + 1;
        }
        return;
    }

    // 4.1.3 — the two SVDs produce DIFFERENT answers on the same input;
    // if they agreed, one would be wrong. (4.1.2's never-materializes
    // claim is structural: SgdMf contains no toDense/toCsr call — grep
    // it — and touches only the sparse accessors.)
    @Test
    public void theTwoSvdsDiffer() {
        Interactions m = BaselinesTest.ratings();
        ZeroFilledSvd z = heap ZeroFilledSvd((int64) 5);
        z.fit(m);
        SgdMf s = heap SgdMf((int64) 20, (uint64) 7);
        s.fit(m);
        // On a MISSING cell the zero-filled model is dragged toward 0
        // by the fill; the observed-only model is not. Find one and
        // compare.
        int64 u = 0;
        boolean differed = false;
        while (u < m.userCount() && !differed) {
            int64 i = 0;
            while (i < m.itemCount() && !differed) {
                if (!m.has(u, i)) {
                    float64 dz = z.predict(u, i);
                    float64 ds = s.predict(u, i);
                    float64 d = dz - ds;
                    if (d < 0.0) { d = -d; }
                    if (d > 0.5) { differed = true; }
                }
                i = i + 1;
            }
            u = u + 1;
        }
        Assert.isTrue(differed);
        return;
    }

    // 4.1.4 + §12.5 — configurable and reproducible: same seed →
    // bit-identical predictions; different seed → different factors.
    @Test
    public void seededFitsReproduce() {
        Interactions m = BaselinesTest.ratings();
        SgdMf a = heap SgdMf((int64) 8, (int64) 5, 0.01, 0.05, (uint64) 11);
        a.fit(m);
        SgdMf b = heap SgdMf((int64) 8, (int64) 5, 0.01, 0.05, (uint64) 11);
        b.fit(m);
        int64 u = 0;
        while (u < m.userCount()) {
            int64 i = 0;
            while (i < m.itemCount()) {
                Assert.equals(Cajeta.f64ToBits(b.predict(u, i)),
                    Cajeta.f64ToBits(a.predict(u, i)));
                i = i + 1;
            }
            u = u + 1;
        }
        SgdMf c = heap SgdMf((int64) 8, (int64) 5, 0.01, 0.05, (uint64) 12);
        c.fit(m);
        float64 d = c.predict((int64) 0, (int64) 0)
            - a.predict((int64) 0, (int64) 0);
        if (d < 0.0) { d = -d; }
        Assert.isTrue(d > 0.0);
        return;
    }

    // 4.1.5 — Surprise SVD parity at the RMSE level (bit parity is
    // impossible across RNGs — DifferencesFromOracles.md): same
    // hyperparameters, same split, held-out RMSE within 0.08 of
    // Surprise's, and comfortably below the global-mean baseline.
    @Test
    public void sgdMfTracksSurpriseRmse() {
        Interactions m = KnnTest.load("rs_knn_train");
        Tensor<float64> tr = Fx.load("rs_knn_test_r");
        int64 n = tr.shapeAt(0);
        int64[] us = KnnTest.mapUsers(m, "rs_knn_test");
        int64[] is = KnnTest.mapItems(m, "rs_knn_test");
        float64[] rs = heap float64[n];
        int64 t = 0;
        while (t < n) { rs[t] = tr.flatGet(t); t = t + 1; }

        SgdMf s = heap SgdMf((int64) 20, (uint64) 7);
        s.fit(m);
        float64 mine = RatingScore.rmse(s, us, is, rs);
        float64 surprise = Fx.load("rs_svd_rmse").flatGet((int64) 0);
        System.stdout.println("svd rmse: mine=" + mine + " surprise="
            + surprise);
        float64 d = mine - surprise;
        if (d < 0.0) { d = -d; }
        Assert.isTrue(d < 0.08);

        GlobalMean g = Baselines.globalMean();
        g.fit(m);
        Assert.isTrue(mine < RatingScore.rmse(g, us, is, rs));
        return;
    }

    // 4.1.6 — soft-thresholding: the completed matrix's singular values
    // are exactly max(σ − τ, 0) of the filled matrix's.
    @Test
    public void svtSoftThresholds() {
        Interactions m = BaselinesTest.ratings();
        float64 tau = 5.0;
        SvtModel model = Svt.complete(m, tau, 0.0);
        // Reference: SVD of the zero-filled dense, shrunk by hand.
        Tensor<float64>[] usv = LinAlg.svd<float64>(m.toDense(0.0));
        Tensor<float64> s = usv[1];
        float64[] got = model.singularValues();
        int64 k = 0;
        while (k < s.shapeAt(0)) {
            float64 want = s.flatGet(k) - tau;
            if (want < 0.0) { want = 0.0; }
            Assert.isTrue(Fx.close(got[k], want, 0.0000000001));
            k = k + 1;
        }
        // And the reconstruction's own SVD carries those values.
        Tensor<float64>[] usv2 = LinAlg.svd<float64>(model.completed());
        Tensor<float64> s2 = usv2[1];
        k = 0;
        while (k < 3) {
            float64 want = s.flatGet(k) - tau;
            if (want < 0.0) { want = 0.0; }
            Assert.isTrue(Fx.close(s2.flatGet(k), want, 0.00000001));
            k = k + 1;
        }
        return;
    }

    // 4.1.7 — the threshold is an ordinary hyperparameter: the search
    // returns the candidate a manual sweep says is best.
    @Test
    public void thresholdSearchIsOrdinary() {
        Interactions m = KnnTest.load("rs_knn_train");
        Tensor<float64> tr = Fx.load("rs_knn_test_r");
        int64 n = tr.shapeAt(0);
        int64[] us = KnnTest.mapUsers(m, "rs_knn_test");
        int64[] is = KnnTest.mapItems(m, "rs_knn_test");
        float64[] rs = heap float64[n];
        int64 t = 0;
        while (t < n) { rs[t] = tr.flatGet(t); t = t + 1; }
        float64[] taus = heap float64[4];
        taus[0] = 0.0; taus[1] = 3.0; taus[2] = 8.0; taus[3] = 20.0;
        int64 best = Svt.searchThreshold(m, taus, 0.0, us, is, rs);
        // Manual sweep with the same machinery must agree.
        int64 manual = 0;
        float64 bestScore = 0.0;
        t = 0;
        while (t < 4) {
            SvtModel md = Svt.complete(m, taus[t], 0.0);
            float64 sc = RatingScore.rmse(md, us, is, rs);
            if (t == 0 || sc < bestScore) { bestScore = sc; manual = t; }
            t = t + 1;
        }
        Assert.equals(best, manual);
        return;
    }

    // 4.1.8 + 4.1.9 — factors are inspectable, and predictions clip to
    // the data's scale (which comes from the data, not a hardcoded 1–5).
    @Test
    public void factorsInspectableAndClipped() {
        Interactions m = BaselinesTest.ratings();
        SgdMf s = heap SgdMf((int64) 6, (uint64) 3);
        s.fit(m);
        float64[] uf = s.userFactor((int64) 0);
        float64[] itf = s.itemFactor((int64) 0);
        Assert.equals((int64) uf.count(), (int64) 6);
        Assert.equals((int64) itf.count(), (int64) 6);

        // A scale of {2..4} (not 1–5): predictions never leave it.
        String[] us = heap String[4];
        String[] is = heap String[4];
        float64[] rs = heap float64[4];
        us[0] = "a"; is[0] = "x"; rs[0] = 2.0;
        us[1] = "a"; is[1] = "y"; rs[1] = 4.0;
        us[2] = "b"; is[2] = "x"; rs[2] = 4.0;
        us[3] = "b"; is[3] = "y"; rs[3] = 2.0;
        Interactions m2 = Interactions.of(us, is, rs);
        ZeroFilledSvd z = heap ZeroFilledSvd((int64) 2);
        z.fit(m2);
        int64 u = 0;
        while (u < 2) {
            int64 i = 0;
            while (i < 2) {
                float64 p = z.predict(u, i);
                Assert.isTrue(p >= 2.0 && p <= 4.0);
                i = i + 1;
            }
            u = u + 1;
        }
        return;
    }
}
